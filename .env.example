# Low-fee EVM RPC. Use a private-transaction-capable endpoint for live trading.
RPC_URL=https://your-rpc.example
CHAIN_ID=8453
CHAIN_NAME=Base
NATIVE_CURRENCY_SYMBOL=ETH

# Obtain the current provider address from Aave's official deployment registry.
AAVE_V3_POOL_ADDRESSES_PROVIDER=0xe20fCBdBfFC4Dd138cE8b2E6FBb6CB49777ad64D
EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000000
KEEPER_ADDRESS=0x0000000000000000000000000000000000000000
WRAPPED_NATIVE_TOKEN=0x4200000000000000000000000000000000000006
ROUTES_FILE=config/routes.json

# Keep the key in this untracked .env only. Never paste it into routes.json or logs.
PRIVATE_KEY=
LIVE_TRADING=false

# Route workers run concurrently. This value is hard-capped at five seconds.
POLL_INTERVAL_MS=2500
SLIPPAGE_BPS=30
GAS_COST_BUFFER_BPS=15000
FIXED_GAS_OVERHEAD_NATIVE=0
MAX_GAS_COST_NATIVE=0.0005
MIN_NET_PROFIT_NATIVE=0.00001
MIN_WALLET_RESERVE_NATIVE=0.0005

# After `pnpm simulate`, set this to I_HAVE_RUN_THE_10_TRADE_SIMULATION.
DEPLOY_CONFIRM=
